#!/usr/bin/env bash
set -euo pipefail

# RayLink CLI dispatcher.
#
# Resolves its own install location (following the symlink in PATH), sources
# the shared library modules, and dispatches to a command under commands/.

RAYLINK_SELF="${BASH_SOURCE[0]}"
RAYLINK_SELF="$(readlink -f "${RAYLINK_SELF}" 2>/dev/null || printf '%s' "${RAYLINK_SELF}")"
RAYLINK_ROOT="$(cd "$(dirname "${RAYLINK_SELF}")" && pwd)"
export RAYLINK_ROOT
export RAYLINK_LIB="${RAYLINK_ROOT}/lib"
export RAYLINK_TEMPLATES="${RAYLINK_ROOT}/templates"
export RAYLINK_DEFAULTS="${RAYLINK_ROOT}/defaults"
export RAYLINK_COMMANDS="${RAYLINK_ROOT}/commands"

RAYLINK_VERSION="$(cat "${RAYLINK_ROOT}/VERSION" 2>/dev/null || echo "dev")"

# Source shared library modules (order matters: common first).
for _mod in common dns xray reality subscription client_outputs healthcheck upstream diagnostics; do
  # shellcheck source=/dev/null
  . "${RAYLINK_LIB}/${_mod}.sh"
done
unset _mod

usage() {
  cat <<USAGE
RayLink ${RAYLINK_VERSION} — one-command Xray VPN node deployer

Usage:
  raylink <command> [options]

Commands:
  exit                Install / update an exit (entry) Reality node.
                      Options:
                        --health-check   Run the lightweight health check only.
  relay               Install / update a relay node that forwards client
                      traffic to an upstream exit node.
                      Requires upstream params (UPSTREAM_VLESS_URI,
                      UPSTREAM_SUBSCRIPTION_URL, or UPSTREAM_* fields).
                      Options:
                        --health-check   Run the lightweight health check only.
  doctor              Diagnose the installed node (read-only): services, ports,
                      timer, config drift, Reality self-test.
  info                Show the installed node's details (secrets hidden;
                      pass --show-secrets to reveal).
  version             Print the RayLink version.
  help                Show this help.

Configuration is passed through environment variables, e.g.:
  sudo env PORT=8443 ENABLE_SUBSCRIPTION=false raylink exit

See docs/ for the full configuration reference.
USAGE
}

RAYLINK_COMMAND="${1:-help}"
shift || true
export RAYLINK_COMMAND

case "${RAYLINK_COMMAND}" in
  exit)
    # shellcheck source=/dev/null
    . "${RAYLINK_COMMANDS}/exit.sh"
    exit_main "$@"
    ;;
  relay)
    # shellcheck source=/dev/null
    . "${RAYLINK_COMMANDS}/relay.sh"
    relay_main "$@"
    ;;
  doctor|info)
    # Run the diagnostic in the installed node's context (auto-detect role).
    _diag="${RAYLINK_COMMAND}"
    _role="$(detect_installed_role)" || {
      echo "No RayLink node found on this server." >&2
      echo "Install one first, e.g.: sudo raylink exit" >&2
      exit 1
    }
    RAYLINK_COMMAND="${_role}"
    export RAYLINK_COMMAND
    # shellcheck source=/dev/null
    . "${RAYLINK_COMMANDS}/${_role}.sh"
    "${_role}_main" "${_diag}" "$@"
    ;;
  version|--version|-v)
    printf '%s\n' "${RAYLINK_VERSION}"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: ${RAYLINK_COMMAND}" >&2
    echo "" >&2
    usage >&2
    exit 1
    ;;
esac
